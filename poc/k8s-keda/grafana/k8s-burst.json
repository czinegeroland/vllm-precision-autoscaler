{
 "uid": "vpa-k8s-burst",
 "title": "vLLM on Kubernetes: KEDA + precision autoscaling",
 "editable": true,
 "schemaVersion": 39,
 "tags": [
  "vllm",
  "keda",
  "precision"
 ],
 "refresh": "5s",
 "time": {
  "from": "now-20m",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "name": "precision switch",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "#eb6834",
    "expr": "changes(vpa_ctl_target_bits[4s]) > 0",
    "step": "2s",
    "titleFormat": "precision switch",
    "textFormat": "{{pod}}"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Per-user speed, whole cluster (tokens/s each user receives)",
   "description": "Generated tokens/s of all replicas divided by the requests they are running.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 14,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[15s])) / avg_over_time(sum(vllm:num_requests_running)[15s:2s])",
     "legendFormat": "per-user tok/s",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(60)",
     "legendFormat": "target (60 tok/s)",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "per-user tok/s"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#2a78d6"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "target (60 tok/s)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e34948"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "state-timeline",
   "title": "Precision per replica",
   "description": "Bits of the weights each replica holds in VRAM (only replicas running the plugin report it).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 10,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vpa_active_bits",
     "legendFormat": "{{pod}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "16": {
         "text": "BF16",
         "color": "#2a78d6",
         "index": 0
        },
        "8": {
         "text": "FP8",
         "color": "#eb6834",
         "index": 1
        },
        "4": {
         "text": "INT4",
         "color": "#7b5cd6",
         "index": 2
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#8a8984",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Replicas (KEDA)",
   "description": "Scheduled = pods KEDA asked for; ready = their vLLM answers. The gap is the cold start.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 5,
    "w": 10,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(vpa_proxy_ready)",
     "legendFormat": "scheduled",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vpa_proxy_ready)",
     "legendFormat": "ready (vLLM serving)",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "scheduled"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8a8984"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ready (vLLM serving)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#2a78d6"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Users per replica (requests running + waiting)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (vllm:num_requests_running) + sum by (pod) (vllm:num_requests_waiting)",
     "legendFormat": "{{pod}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(vllm:num_requests_running) or vector(0)) + (sum(vllm:num_requests_waiting) or vector(0))",
     "legendFormat": "all users (KEDA's metric)",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "all users (KEDA's metric)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8a8984"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Output throughput (tokens/s, all users)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[15s]))",
     "legendFormat": "tokens/s",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "tokens/s"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#2a78d6"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Time to first token, p95 (s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[30s])))",
     "legendFormat": "p95",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "p95"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#eb6834"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}