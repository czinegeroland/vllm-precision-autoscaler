{
 "uid": "vpa-precision",
 "title": "vLLM precision autoscaling",
 "editable": true,
 "schemaVersion": 39,
 "tags": [
  "vllm",
  "precision"
 ],
 "refresh": "5s",
 "time": {
  "from": "now-20m",
  "to": "now"
 },
 "timezone": "browser",
 "annotations": {
  "list": [
   {
    "name": "precision switch",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "#eb6834",
    "expr": "changes(vpa_ctl_target_bits[4s]) > 0",
    "step": "2s",
    "titleFormat": "precision switch",
    "textFormat": "controller changed precision"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Per-user speed (tokens/s each user receives) vs target",
   "description": "Generated tokens/s divided by running requests. (vLLM's inter-token latency histogram is too coarse for this: its buckets jump from 10 ms to 25 ms.)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 14,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[15s])) / avg_over_time(sum(vllm:num_requests_running)[15s:2s])",
     "legendFormat": "per-user tok/s",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vpa_ctl_per_user_tok_s",
     "legendFormat": "as measured by the controller",
     "refId": "B",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(60)",
     "legendFormat": "target (60 tok/s)",
     "refId": "C",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "per-user tok/s"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d8d9da"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "as measured by the controller"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8a8984"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "target (60 tok/s)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e34948"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "state-timeline",
   "title": "Precision of the weights in VRAM",
   "description": "Bits of the version most layers hold (plugin) and the version the controller asked for.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 10,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vpa_active_bits",
     "legendFormat": "active",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vpa_ctl_target_bits",
     "legendFormat": "controller target",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": true
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "16": {
         "text": "16-bit",
         "color": "#2a78d6",
         "index": 0
        },
        "8": {
         "text": "FP8",
         "color": "#eb6834",
         "index": 1
        },
        "4": {
         "text": "INT4",
         "color": "#1baf7a",
         "index": 2
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#555",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Users (requests running + waiting)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 5,
    "w": 10,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_running)",
     "legendFormat": "running",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_waiting)",
     "legendFormat": "waiting (queued)",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "running"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d8d9da"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "waiting (queued)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#eb6834"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Output throughput (tokens/s, all users)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[15s]))",
     "legendFormat": "tokens/s",
     "refId": "A",
     "range": true
